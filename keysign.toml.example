# keysign settings; copy to ~/.config/keysign/keysign.toml (or ./keysign.toml)
# and adjust.

name  = "Alice Example"
email = "alice@example.org"
keyid = "0123456789ABCDEF0123456789ABCDEF01234567"   # your full fingerprint

# Command that sends one mail: the message is fed on stdin and the
# recipient address is appended as the last argument.
sendmail = ["msmtp", "-a", "default", "-f", "alice@example.org", "--"]
# sendmail = ["/usr/sbin/sendmail", "-f", "alice@example.org", "--"]

# Local clone of the kernel.org pgpkeys repo, used as a key source. Optional;
# leave it out to skip it. Get it with
#   git clone https://git.kernel.org/pub/scm/docs/kernel/pgpkeys.git
pgpkeys    = "~/src/pgpkeys"

keyservers = ["hkps://keyserver.ubuntu.com", "hkps://keys.openpgp.org"]
maildir    = "mail"   # mail/outbox, mail/sent, mail/imported
